# ---- Jalora AI environment configuration ----
# Copy this file to `jalora\.env` (the project root of the app, next to backend\)
# and fill in the secrets you have. config.py reads it from there.
# NEVER commit the real .env file. NEVER hard-code API keys in source.

JALORA_ENV=development
JALORA_JWT_SECRET=change-me-to-a-long-random-string
JALORA_JWT_EXPIRE_MINUTES=1440
# Production: generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
JALORA_CREDENTIALS_ENCRYPTION_KEY=
# Local SQLite is the default (config.py resolves to <BASE_DIR>/data/jalora.db).
# Uncomment & edit to use PostgreSQL in production:
# JALORA_DATABASE_URL=postgresql+psycopg://user:password@host:5432/jalora
JALORA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI providers (add only the ones you use; all optional) ----
JALORA_OPENAI_API_KEY=
JALORA_OPENAI_MODEL=gpt-4o-mini
JALORA_OPENAI_REASONING_MODEL=gpt-4o

JALORA_ANTHROPIC_API_KEY=
JALORA_ANTHROPIC_MODEL=claude-sonnet-4-5

JALORA_GOOGLE_API_KEY=
JALORA_GOOGLE_MODEL=gemini-2.5-flash

# ---- Creative Studio: local AI image generation (diffusers / Stable Diffusion) ----
# Install with: pip install torch diffusers transformers safetensors accelerate
# The local provider (LocalImageProvider) uses SDXL-Lightning by default (4-step,
# CFG=0, Euler scheduler) and falls back to SD 1.5 + LCM-LoRA on RAM-constrained
# machines. Without torch/diffusers it falls back to a procedural engine.
# auto | openai | google | local | local-ai
JALORA_IMAGE_PROVIDER=auto
# auto | sdxl-lightning | sd15-lcm | sd15-default
# Leave blank for auto-selection based on available RAM (recommended).
JALORA_IMAGE_LOCAL_MODEL=
# Inference steps (Lightning/LCM: 1-8; default: 20-50)
JALORA_IMAGE_LOCAL_STEPS=4
# Guidance scale (0.0 = no CFG; use 0.0 for distilled models like Lightning/LCM)
JALORA_IMAGE_LOCAL_GUIDANCE_SCALE=0.0
# Img2img denoising strength (0=keep reference, 1=full regeneration)
JALORA_IMAGE_LOCAL_STRENGTH=0.75
# HuggingFace token (only needed for gated models like SDXL inpainting)
JALORA_HF_TOKEN=
# auto | cpu | cuda | mps
JALORA_IMAGE_LOCAL_DEVICE=auto
# Minimum free RAM (GB) to attempt the SDXL tier (falls back to SD 1.5 below this)
JALORA_IMAGE_LOCAL_MAX_RAM_GB=4.0
# OpenAI image generation (defaults to gpt-image-1)
JALORA_IMAGE_MODEL=
# Rate limiting for image generation (per user, per minute)
JALORA_IMAGE_RATE_LIMIT_PER_MIN=20
# Monthly cost cap for cloud image generation in USD (0 = unlimited)
JALORA_IMAGE_COST_CAP_USD=50.0

JALORA_GROQ_API_KEY=
JALORA_GROQ_MODEL=openai/gpt-oss-20b

JALORA_DEEPSEEK_API_KEY=
JALORA_DEEPSEEK_MODEL=deepseek-chat

JALORA_MISTRAL_API_KEY=
JALORA_MISTRAL_MODEL=mistral-large-latest

JALORA_OPENROUTER_API_KEY=
JALORA_OPENROUTER_MODEL=openai/gpt-4o-mini

# Local models via Ollama (no API key needed)
JALORA_OLLAMA_BASE_URL=http://localhost:11434
# `ollama_model` is the capable model; `ollama_mid_model` an intermediate
# tier; `ollama_light_model` the fallback; and `ollama_survival_model` the
# ultra-light last resort when RAM is extremely scarce. The router loads the
# heaviest model that fits in free RAM (minus the resident footprint of the
# other already-loaded tier models); the background monitor unloads loaded
# heavy models when free RAM drops below SAFE_RAM_FLOOR_GB to avoid
# llama-server OOM; the mid/light + survival models are kept resident so
# later requests still work.
JALORA_OLLAMA_MODEL=qwen2.5:7b
JALORA_OLLAMA_MID_MODEL=llama3.2:latest
JALORA_OLLAMA_LIGHT_MODEL=qwen2.5:1.5b
JALORA_OLLAMA_SURVIVAL_MODEL=qwen2.5:0.5b
JALORA_OLLAMA_TIMEOUT_SECONDS=60
JALORA_LOCAL_PROVIDER_PREFERENCE=ollama
JALORA_OLLAMA_HEAVY_MODEL_MIN_FREE_GB=4.0
JALORA_OLLAMA_MID_MODEL_MIN_FREE_GB=2.0
JALORA_OLLAMA_LIGHT_MODEL_MIN_FREE_GB=1.0
JALORA_OLLAMA_SURVIVAL_MODEL_MIN_FREE_GB=0.4
JALORA_OLLAMA_SAFE_RAM_FLOOR_GB=1.5
# Ollama generation options (sent with every local call). num_ctx scales per
# tier; repeat_penalty/top_p cut repetition on the small models.
JALORA_OLLAMA_NUM_CTX_HEAVY=32768
JALORA_OLLAMA_NUM_CTX_MID=16384
JALORA_OLLAMA_NUM_CTX_LIGHT=16384
JALORA_OLLAMA_NUM_CTX_SURVIVAL=8192
JALORA_OLLAMA_TOP_P=0.9
JALORA_OLLAMA_REPEAT_PENALTY=1.15
# How long each resident model stays warm after a request (seconds): heavy
# models are released quickly to free RAM, small tiers linger for speed.
JALORA_OLLAMA_KEEP_ALIVE_HEAVY_SECONDS=120
JALORA_OLLAMA_KEEP_ALIVE_MID_SECONDS=600
JALORA_OLLAMA_KEEP_ALIVE_LIGHT_SECONDS=900
JALORA_OLLAMA_KEEP_ALIVE_SURVIVAL_SECONDS=3600

# Optional standalone LoRA inference server.
JALORA_LORA_ENABLED=false
JALORA_LORA_ADAPTER_PATH=jalora/lora_adapters/jalora_lora
JALORA_LORA_BASE_MODEL=Qwen/Qwen1.5-0.5B-Chat
# Intent-based tool binding: bind only the tools relevant to the turn's intent
# instead of the full registry (false = always bind everything).
JALORA_AGENT_TOOL_ROUTING_ENABLED=true

# ---- Router behaviour ----
# auto | openai | anthropic | google | groq | deepseek | mistral | openrouter | ollama
JALORA_DEFAULT_PROVIDER=auto
JALORA_EMBEDDING_PROVIDER=auto
JALORA_SEARCH_PROVIDER=duckduckgo

# ---- Optional integrations (Phase 6: communication) ----
# Primary provider: auto -> telnyx, then twilio, then mock.
JALORA_COMMS_PROVIDER=auto

# Telnyx (primary): SMS / WhatsApp / voice.
#  api_key        - Portal personal API key (Bearer auth)
#  public_key     - Ed25519 webhook public key (base64) for signature checks
#  account_sid    - TeXML account UUID (used by /v2/texml/Accounts/{sid}/Calls)
#  application_id - TeXML application (ApplicationSid) that owns the call
#  connection_id  - Call Control connection (optional)
#  from_number    - voice caller ID + SMS sender (E.164)
#  whatsapp_from  - WhatsApp-enabled number (E.164)
#  messaging_profile_id - messaging profile that owns the numbers (optional)
JALORA_TELNYX_API_KEY=
JALORA_TELNYX_PUBLIC_KEY=
JALORA_TELNYX_ACCOUNT_SID=
JALORA_TELNYX_APPLICATION_ID=
JALORA_TELNYX_CONNECTION_ID=
JALORA_TELNYX_FROM_NUMBER=
JALORA_TELNYX_WHATSAPP_FROM=
JALORA_TELNYX_MESSAGING_PROFILE_ID=

# Twilio (fallback — previously primary; kept for compatibility).
JALORA_TWILIO_ACCOUNT_SID=
JALORA_TWILIO_AUTH_TOKEN=
JALORA_TWILIO_FROM_NUMBER=
JALORA_TWILIO_WHATSAPP_FROM=

# ---- Phase F: phone calls (§31-33, §57) ----
# Voice call budgets are enforced regardless of provider; `calls_base_url` must
# point at a public URL where the provider can reach the /api/calls/* webhooks
# and the media WebSocket when you dial real numbers.
JALORA_CALL_MAX_TURNS=20
JALORA_CALL_MAX_DURATION_SECONDS=600
JALORA_CALLS_BASE_URL=http://localhost:5173

# ---- Phase 1: live in-app voice call (server-streaming STT/TTS) ----
# Master switch for the WebSocket pipeline at /api/voice/live.
JALORA_VOICE_ENABLED=true
# Provider chains; `auto` = local-first -> cloud -> mock.
#   STT: faster_whisper | openai | auto
#   TTS: piper | openai | auto
#   LLM: auto | ollama | openai | ... (auto = Ollama-first, then cloud fallback)
JALORA_VOICE_STT_PROVIDER=auto
JALORA_VOICE_TTS_PROVIDER=auto
JALORA_VOICE_LLM_PROVIDER=auto
# Latency budget (ms) before the Ollama-first route falls back to a fast cloud
# provider (0 = strict Ollama-first, never fall back for latency).
JALORA_VOICE_LATENCY_BUDGET_MS=1200
# Optional explicit cloud fallback provider name (e.g. groq); empty = next in chain.
JALORA_VOICE_FALLBACK_PROVIDER=
# faster-whisper local model + precision (tiny|base|small|... ; int8|float16|...).
JALORA_VOICE_STT_MODEL=base
JALORA_VOICE_STT_COMPUTE_TYPE=int8
# Absolute path to a Piper .onnx voice (and matching .onnx.json). Empty => the
# TTS chain skips Piper and uses the next provider (OpenAI -> mock).
JALORA_PIPER_VOICE_PATH=
# Audio contract: client streams PCM16 mono @ voice_sample_rate; server TTS
# streams PCM16 @ voice_tts_sample_rate. Max call length in seconds.
JALORA_VOICE_SAMPLE_RATE=16000
JALORA_VOICE_TTS_SAMPLE_RATE=22050
JALORA_VOICE_MAX_SECONDS=600

# ---- Phase 2/3: phone calls via Telnyx/Twilio Media Streams ----
# Public base URL the provider can reach (ngrok/tunnel in dev). Must be https in
# prod; the media WebSocket URL is derived (http->ws, https->wss). Empty falls
# back to JALORA_CALLS_BASE_URL.
JALORA_VOICE_PUBLIC_URL=
# Answer inbound calls with a live AI session. Requires the owner email below and
# configured telephony credentials (otherwise inbound calls are rejected).
JALORA_VOICE_INBOUND_ENABLED=false
# Which registered user owns inbound calls (routes the AI to their data/tools).
JALORA_VOICE_INBOUND_EMAIL=
# Lifetime (seconds) of the signed `?token=` authorising a media-stream socket.
JALORA_VOICE_STREAM_TOKEN_SECONDS=3600

# ---- Phase E: Email / Gmail (§34-38, §76) ----
# auto | mock | gmail  (mock = deterministic provider for offline use/tests)
JALORA_EMAIL_PROVIDER=auto
# The app's official sending address. For live Gmail you must create OAuth
# credentials (Google Cloud console) and set the three values below.
JALORA_GMAIL_FROM=jaloraai1318@gmail.com
# Single source for all public URLs. The Gmail OAuth callback is derived from
# it (e.g. http://localhost:5173/api/integrations/gmail/callback); it must also
# match the frontend origin for CORS. Use http://localhost:8000 when the SPA is
# served by the backend itself, and the real domain in production.
JALORA_PUBLIC_BASE_URL=http://localhost:5173
# Optional override of the OAuth callback. Leave empty to derive it from
# JALORA_PUBLIC_BASE_URL. Whatever value is used MUST be registered
# byte-for-byte as an "Authorized redirect URI" on the Google OAuth client.
JALORA_GMAIL_REDIRECT_URI=
JALORA_GMAIL_CLIENT_ID=
JALORA_GMAIL_CLIENT_SECRET=
# Shared secret that signs inbound webhook pushes (set once in prod; when
# empty the inbound endpoint skips verification, so never leave it empty in
# production). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JALORA_GMAIL_PUSH_TOKEN=

# ---- Phase N: generic OAuth integrations (§63) ----
# Personal Assistant integrations connect through a single shared callback URI
# derived from JALORA_PUBLIC_BASE_URL:
#   {JALORA_PUBLIC_BASE_URL}/api/integrations/oauth/callback
# Register that exact URI on each provider's OAuth app. Google (Calendar/Drive)
# and Gmail reuse JALORA_GMAIL_CLIENT_ID / JALORA_GMAIL_CLIENT_SECRET above.
# Each provider stays "Add credentials to connect" in the UI until its pair is
# set. The same callback URI is used for every provider below.
JALORA_SLACK_CLIENT_ID=
JALORA_SLACK_CLIENT_SECRET=
JALORA_GITHUB_CLIENT_ID=
JALORA_GITHUB_CLIENT_SECRET=
JALORA_NOTION_CLIENT_ID=
JALORA_NOTION_CLIENT_SECRET=
JALORA_SPOTIFY_CLIENT_ID=
JALORA_SPOTIFY_CLIENT_SECRET=
JALORA_DROPBOX_CLIENT_ID=
JALORA_DROPBOX_CLIENT_SECRET=

# ---- Phase N (§76): Payments (Stripe Connect OAuth, per-user) ----
# auto | mock | stripe
JALORA_PAYMENTS_PROVIDER=auto
JALORA_STRIPE_CLIENT_ID=
JALORA_STRIPE_CLIENT_SECRET=

# ---- Phase N (§76): Travel / flight booking (Amadeus M2M, env-keyed) ----
# auto | mock | amadeus
JALORA_TRAVEL_PROVIDER=auto
JALORA_AMADEUS_CLIENT_ID=
JALORA_AMADEUS_CLIENT_SECRET=
JALORA_AMADEUS_BASE_URL=https://test.api.amadeus.com

# ---- Phase C: browser automation (§16–19) ----
# Real persistent browser sessions use Playwright (installed via
# `pip install playwright`). Addresses that are private/reserved (127.0.0.1,
# 10.x, 192.168.x, link-local, etc.) are blocked unless you explicitly allow.
JALORA_BROWSE_ALLOW_PRIVATE=false
JALORA_BROWSER_TIMEOUT_SECONDS=20
# auto | real | fake  (fake = deterministic offline driver for tests/dev)
JALORA_BROWSER_DRIVER=auto
# Safety net: close a browser session that has been idle this long (seconds).
JALORA_BROWSER_SESSION_IDLE_SECONDS=900

# ---- Phase C: login credentials (§18) ----
# Your login username/password are encrypted at rest with a Fernet key.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production requires a dedicated key; development may derive a key from
# JALORA_JWT_SECRET when this is blank. Back up the key separately and do not
# rotate it without re-encrypting existing credential rows.
JALORA_CREDENTIALS_ENCRYPTION_KEY=

# ---- Phase G: scheduling & reminders (§49-51, §61-62) ----
# Disable in ephemeral/test environments so jobs never fire against transient
# databases. Trigger times are interpreted in UTC.
JALORA_SCHEDULER_ENABLED=true
JALORA_SCHEDULER_TIMEZONE=UTC

# ---- Features ----
JALORA_MEMORY_ENABLED=true
JALORA_RATE_LIMIT_AUTH_PER_MIN=60
JALORA_RATE_LIMIT_GLOBAL_PER_MIN=120

# ---- Phase L: Observability (§58) ----
# Optional distributed tracing via LangSmith or OpenTelemetry.
JALORA_TRACING_ENABLED=false
JALORA_TRACING_PROVIDER=none
JALORA_LANGSMITH_API_KEY=
JALORA_OTEL_ENDPOINT=

# ---- Phase L: Redis (for run registry + rate limits in multi-worker deployments) ----
# When unset (or unreachable) the app falls back to in-memory backends.
JALORA_REDIS_URL=

# ---- Phase L: Session & audit (§74/75) ----
JALORA_REFRESH_TOKEN_EXPIRE_DAYS=30
JALORA_REDACT_AUDIT_ENABLED=true

# ---- Conversation context (spec 26, 79) ----
# Newest N messages are loaded; above the threshold the older part is
# summarised with one model call and only `summary_keep` stay verbatim.
JALORA_HISTORY_LIMIT=40
JALORA_SUMMARY_THRESHOLD=32
JALORA_SUMMARY_KEEP=12


JALORA_GOOGLE_MAPS_API_KEY=your_maps_key_here